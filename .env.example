# jira-to-backlogmd — copy to a file outside the repository (e.g. ~/.config/jira-to-backlogmd.env),
# chmod 600, and pass it with --env-file or load it in your systemd unit / shell.
# Use a dedicated bot user restricted to the synced project.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_USER_EMAIL=jira-bot@example.com
JIRA_API_TOKEN=
